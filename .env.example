# EAIMOS Root Environment Configuration

# --- Authentication Settings ---
# Secret key used for signing JWT access and refresh tokens. Make sure it's at least 32 characters long.
SECRET_KEY=SUPER_SECRET_JWT_KEY_MIN_32_CHARS_LONG_PLEASE_REPLACE_IN_PRODUCTION
# Dedicated master key for encrypting stored provider secrets. MUST differ from SECRET_KEY.
ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_64_HEX_CHAR_RANDOM_SECRET

# --- AI Gateway Provider API Keys ---
# Provide these keys to activate real model completions in the AI Playground and Content Generator.
# If left blank, the platform automatically runs in simulation/mock mode for development convenience.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email Provider Configuration ---
# Options: 'mailpit' (default for local development), 'brevo_smtp' (real-email testing), 'resend', or 'smtp'
EMAIL_PROVIDER=mailpit

# Sender information
# For Mailpit development: any placeholder is valid (e.g. developer@example.test)
# For Brevo real-email testing: must be an address accepted/verified by Brevo (no custom domain required)
EMAIL_FROM=developer@example.test
EMAIL_FROM_NAME=EAIMOS Platform

# Local Development SMTP (Mailpit in Docker Compose)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=30

# Brevo Real-Email Testing (Opt-in)
# Set EMAIL_PROVIDER=brevo_smtp when testing real inbox delivery.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_smtp_login
# SMTP_PASSWORD=your_brevo_smtp_key
# EMAIL_FROM=your_verified_brevo_sender@gmail.com

# Resend Transactional Email (Optional)
# RESEND_API_KEY=re_your_api_key

# --- Observability Settings ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=eaimos-api
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/mock-webhook
ALERT_EMAIL_RECIPIENT=alerts@eaimos.ai

