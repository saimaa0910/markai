{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@eaimos/types/*": ["packages/types/src/*"],
      "@eaimos/shared/*": ["packages/shared/src/*"],
      "@eaimos/ui/*": ["packages/ui/src/*"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
