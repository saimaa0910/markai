# EAIMOS Production Container Environment Configurations
SECRET_KEY=GENERATE_A_RANDOM_LONG_SECRET_KEY_FOR_JWT_TOKEN_SIGNING_IN_PRODUCTION
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Production Postgres / Redis / MinIO Orchestration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eaimos
DATABASE_URL=postgresql://postgres:postgres@db:5432/eaimos
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

ENVIRONMENT=production
CORS_ORIGINS=http://localhost,http://127.0.0.1
