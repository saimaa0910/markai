# EAIMOS Production Container Environment Configurations
SECRET_KEY=169679afaa01978f2efaad7e956c698df5dcc54e91692d76af1ea07515b91691 
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Production Postgres / Redis / MinIO Orchestration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eaimos
DATABASE_URL=postgresql://postgres:postgres@db:5432/eaimos
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

ENVIRONMENT=production
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# --- Email Configuration ---
# Resend (primary) — leave blank to use SMTP fallback below
RESEND_API_KEY=

# Email sender identity
EMAIL_FROM=noreply@eaimos.ai
EMAIL_FROM_NAME=EAIMOS Platform

# SMTP fallback — points to Mailpit dev mail catcher
# View all caught emails at: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
