# Sprint 8.3.1 - Authentication Lifecycle Environment Variables
# ==============================================================
# Add these to your existing .env file

# Required for invitation email URLs
# This should point to your frontend application URL
FRONTEND_URL=http://localhost:3000

# Email Service Configuration (choose one)
# ----------------------------------------

# Option 1: Resend API (Recommended)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Option 2: SMTP Server (Legacy)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=EAIMOS Platform

# Database Configuration
# ----------------------
# Ensure your database connection string is set
# DATABASE_URL=postgresql://user:password@localhost:5432/eaimos

# Session Configuration
# ---------------------
# JWT settings (should already exist)
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Account Deletion Settings
# -------------------------
# Grace period before permanent deletion (days)
ACCOUNT_DELETION_GRACE_DAYS=7

# Temporary Password Settings
# ---------------------------
# Expiration time for invitation temporary passwords (hours)
TEMPORARY_PASSWORD_EXPIRE_HOURS=72

# Security Settings
# -----------------
# Maximum failed login attempts before lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# Account lockout duration (minutes)
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Password Policy
# ---------------
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_UPPERCASE=true
REQUIRE_PASSWORD_LOWERCASE=true
REQUIRE_PASSWORD_DIGIT=true
REQUIRE_PASSWORD_SPECIAL_CHAR=false
